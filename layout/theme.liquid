<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Inlined Theme Variables -->
    {% render 'css-variables' %}

    <!-- Load Theme Critical CSS -->
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    <!-- Social & Meta Tags -->
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <!-- Client Theme JS -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body>
    <!-- Customizable Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Sticky Transparent / Solid Header -->
    {% sections 'header-group' %}

    <!-- Main Dynamic Content -->
    <main id="MainContent" role="main" class="kmh-main">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    {% sections 'footer-group' %}

    <!-- Global Modals & Drawers -->
    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}
    {% render 'quick-view-modal' %}
    {% render 'ar-modal' %}
  </body>
</html>
