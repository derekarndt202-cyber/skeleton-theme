        &copy; {{ 'now' | date: "%Y" }} <strong>KitchenMixHaven Inc.</strong> All Rights Reserved. Crafted for Extraordinary Culinary Experiences.
      </div>

      <!-- Accepted Payment Badges -->
      <div style="display: flex; align-items: center; gap: 10px; font-size: 0.75rem; color: #64748B;">
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">VISA</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">MC</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">AMEX</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">APPLE PAY</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">SHOP PAY</span>
      </div>
    </div>

  </div>
</footer>

