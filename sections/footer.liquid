{% comment %}
  KitchenMixHaven - Premium Ecommerce Storefront Footer
  Features:
  - 4-Pillar Trust & Reassurance Strip with bespoke vector icons
  - Integrated Customer Newsletter Subscription with Shopify native customer form
  - Multi-column categorized navigation (Shop, Customer Care, Discover, Legal)
  - Interactive Mobile Accordion navigation for clean mobile UX
  - Direct Customer Support information & business hours
  - Crisp Vector Social Media Channels
  - Vector Payment Method badges (Visa, Mastercard, Amex, Discover, Apple Pay, Google Pay, Shop Pay, PayPal)
  - Complete Schema Customizer settings & menu link_list controls
{% endcomment %}

<footer class="kmh-footer" role="contentinfo">
  <!-- Subtle Ambient Glow -->
  <div class="kmh-footer__ambient-glow" aria-hidden="true"></div>

  <div class="kmh-container">

    {% if section.settings.show_trust_bar %}
      <!-- 1. Trust & Reassurance Strip -->
      <section class="kmh-footer__trust-strip" aria-label="Store Benefits & Guarantees">
        <div class="kmh-footer__trust-grid">
          
          <div class="kmh-footer__trust-item">
            <div class="kmh-footer__trust-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="2" ry="2"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </div>
            <div class="kmh-footer__trust-content">
              <h5 class="kmh-footer__trust-title">{{ section.settings.trust_1_title | default: "Free Shipping on Orders $150+" }}</h5>
              <p class="kmh-footer__trust-desc">{{ section.settings.trust_1_desc | default: "Fast, reliable dispatch on all continental US orders." }}</p>
            </div>
          </div>

          <div class="kmh-footer__trust-item">
            <div class="kmh-footer__trust-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>
            <div class="kmh-footer__trust-content">
              <h5 class="kmh-footer__trust-title">{{ section.settings.trust_2_title | default: "100% Secure Checkout" }}</h5>
              <p class="kmh-footer__trust-desc">{{ section.settings.trust_2_desc | default: "Bank-grade 256-bit encrypted SSL payment processing." }}</p>
            </div>
          </div>

          <div class="kmh-footer__trust-item">
            <div class="kmh-footer__trust-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                <path d="M21 3v5h-5"/>
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                <path d="M8 16H3v5"/>
              </svg>
            </div>
            <div class="kmh-footer__trust-content">
              <h5 class="kmh-footer__trust-title">{{ section.settings.trust_3_title | default: "30-Day Easy Returns" }}</h5>
              <p class="kmh-footer__trust-desc">{{ section.settings.trust_3_desc | default: "Straightforward, stress-free return and exchange policy." }}</p>
            </div>
          </div>

          <div class="kmh-footer__trust-item">
            <div class="kmh-footer__trust-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                <circle cx="9" cy="10" r="1"/>
                <circle cx="12" cy="10" r="1"/>
                <circle cx="15" cy="10" r="1"/>
              </svg>
            </div>
            <div class="kmh-footer__trust-content">
              <h5 class="kmh-footer__trust-title">{{ section.settings.trust_4_title | default: "Dedicated Customer Care" }}</h5>
              <p class="kmh-footer__trust-desc">{{ section.settings.trust_4_desc | default: "Expert product advice & order support ready to help." }}</p>
            </div>
          </div>

        </div>
      </section>
    {% endif %}

    {% if section.settings.show_newsletter %}
      <!-- 2. Newsletter Signup Banner -->
      <section class="kmh-footer__newsletter-card" aria-label="Newsletter Signup">
        <div class="kmh-footer__newsletter-inner">
          <div class="kmh-footer__newsletter-info">
            <span class="kmh-footer__newsletter-badge">Culinary Community</span>
            <h3 class="kmh-footer__newsletter-heading">{{ section.settings.newsletter_heading | default: "Join the KitchenMixHaven Community" }}</h3>
            <p class="kmh-footer__newsletter-subtext">{{ section.settings.newsletter_subtext | default: "Receive seasonal recipes, baking techniques, appliance guides, and new product announcements straight to your inbox." }}</p>
          </div>

          <div class="kmh-footer__newsletter-form-wrapper">
            {% form 'customer', id: 'kmh-footer-newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter, footer_signup">
              
              {% if form.posted_successfully? %}
                <div class="kmh-footer__form-success" role="alert">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                  <span>Thank you for subscribing! Check your inbox for your welcome guide.</span>
                </div>
              {% else %}
                {% if form.errors %}
                  <div class="kmh-footer__form-error" role="alert">
                    <span>{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
                  </div>
                {% endif %}

                <div class="kmh-footer__input-row">
                  <label for="kmh-footer-email-input" class="visually-hidden">Email Address</label>
                  <input
                    type="email"
                    id="kmh-footer-email-input"
                    name="contact[email]"
                    class="kmh-footer__input"
                    value="{% if customer %}{{ customer.email }}{% endif %}"
                    placeholder="Enter your email address..."
                    required
                    autocomplete="email"
                    autocapitalize="off"
                    aria-label="Email address for newsletter"
                  >
                  <button type="submit" class="kmh-footer__submit-btn" aria-label="Subscribe to newsletter">
                    <span>Subscribe</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
                <span class="kmh-footer__privacy-note">We respect your privacy. No spam, ever. Unsubscribe at any time.</span>
              {% endif %}
            {% endform %}
          </div>
        </div>
      </section>
    {% endif %}

    <!-- 3. Main Navigation Grid -->
    <nav class="kmh-footer__nav-grid" aria-label="Footer Navigation">
      
      <!-- Brand & Contact Column -->
      <div class="kmh-footer__col kmh-footer__col--brand">
        <a href="/" class="kmh-footer__brand-link" aria-label="KitchenMixHaven Home">
          <img src="{{ 'favicon.jpg' | asset_url }}" alt="KitchenMixHaven Emblem" class="kmh-footer__logo-img" width="40" height="40" loading="lazy">
          <span class="kmh-footer__logo-text">
            KITCHEN<span class="kmh-footer__logo-accent">MIX</span>HAVEN
          </span>
        </a>

        <p class="kmh-footer__brand-desc">
          Quality kitchen appliances and precision tools designed to make everyday cooking, baking, and meal preparation easier.
        </p>

        <!-- Direct Contact Information -->
        <div class="kmh-footer__contact-info">
          <div class="kmh-footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--kmh-gold)" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <a href="mailto:support@kitchenmixhaven.example.com" class="kmh-footer__contact-link">support@kitchenmixhaven.example.com</a>
          </div>
          <div class="kmh-footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--kmh-gold)" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Mon – Fri: 9:00 AM – 6:00 PM EST</span>
          </div>
        </div>

        <!-- Social Media Icons -->
        <div class="kmh-footer__social-links">
          <a href="{{ section.settings.social_instagram | default: 'https://instagram.com' }}" target="_blank" rel="noopener" aria-label="KitchenMixHaven on Instagram" class="kmh-footer__social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="{{ section.settings.social_facebook | default: 'https://facebook.com' }}" target="_blank" rel="noopener" aria-label="KitchenMixHaven on Facebook" class="kmh-footer__social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="{{ section.settings.social_pinterest | default: 'https://pinterest.com' }}" target="_blank" rel="noopener" aria-label="KitchenMixHaven on Pinterest" class="kmh-footer__social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C6.48 2 2 6.48 2 12c0 4.17 2.54 7.74 6.14 9.22-.08-.77-.16-1.97.03-2.82.18-.77 1.15-4.88 1.15-4.88s-.3-.59-.3-1.46c0-1.37.8-2.39 1.79-2.39.84 0 1.25.63 1.25 1.39 0 .85-.54 2.12-.82 3.3-.23.98.49 1.78 1.45 1.78 1.74 0 3.08-1.84 3.08-4.49 0-2.35-1.69-3.99-4.1-3.99-2.79 0-4.43 2.09-4.43 4.26 0 .84.32 1.74.73 2.24.08.1.09.19.07.29-.07.31-.24.97-.27 1.1-.04.18-.15.22-.34.13-1.28-.59-2.08-2.46-2.08-3.96 0-3.23 2.35-6.19 6.77-6.19 3.55 0 6.32 2.53 6.32 5.92 0 3.53-2.22 6.37-5.31 6.37-1.04 0-2.01-.54-2.35-1.18l-.64 2.44c-.23.89-.86 2.01-1.28 2.7C9.35 21.84 10.64 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
            </svg>
          </a>
          <a href="{{ section.settings.social_youtube | default: 'https://youtube.com' }}" target="_blank" rel="noopener" aria-label="KitchenMixHaven on YouTube" class="kmh-footer__social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: SHOP -->
      <div class="kmh-footer__col kmh-footer__accordion">
        <button class="kmh-footer__accordion-trigger" aria-expanded="false">
          <span class="kmh-footer__col-heading">Shop Appliances</span>
          <svg class="kmh-footer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="kmh-footer__accordion-content">
          <ul class="kmh-footer__link-list">
            {% if section.settings.menu_categories.links.size > 0 %}
              {% for link in section.settings.menu_categories.links %}
                <li><a href="{{ link.url }}" class="kmh-footer__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all" class="kmh-footer__link">Shop All Appliances</a></li>
              <li><a href="/collections/stand-mixers" class="kmh-footer__link">Stand Mixers</a></li>
              <li><a href="/collections/hand-mixers" class="kmh-footer__link">Hand Mixers</a></li>
              <li><a href="/collections/air-fryers" class="kmh-footer__link">Air Fryers & Ovens</a></li>
              <li><a href="/collections/toasters" class="kmh-footer__link">Toasters</a></li>
              <li><a href="/collections/kitchen-accessories" class="kmh-footer__link">Attachments & Accessories</a></li>
              <li><a href="/pages/gift-guide" class="kmh-footer__link">Kitchen Gift Guide</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Column 3: CUSTOMER CARE -->
      <div class="kmh-footer__col kmh-footer__accordion">
        <button class="kmh-footer__accordion-trigger" aria-expanded="false">
          <span class="kmh-footer__col-heading">Customer Care</span>
          <svg class="kmh-footer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="kmh-footer__accordion-content">
          <ul class="kmh-footer__link-list">
            {% if section.settings.menu_support.links.size > 0 %}
              {% for link in section.settings.menu_support.links %}
                <li><a href="{{ link.url }}" class="kmh-footer__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/contact" class="kmh-footer__link">Contact Support</a></li>
              <li><a href="/pages/order-tracking" class="kmh-footer__link">Track Your Order</a></li>
              <li><a href="/policies/shipping-policy" class="kmh-footer__link">Shipping & Delivery Rates</a></li>
              <li><a href="/policies/refund-policy" class="kmh-footer__link">Returns & Refunds Policy</a></li>
              <li><a href="/pages/faq" class="kmh-footer__link">Frequently Asked Questions</a></li>
              <li><a href="/pages/compatibility" class="kmh-footer__link">Mixer Fitment Verification</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Column 4: DISCOVER & INSPIRATION -->
      <div class="kmh-footer__col kmh-footer__accordion">
        <button class="kmh-footer__accordion-trigger" aria-expanded="false">
          <span class="kmh-footer__col-heading">Discover</span>
          <svg class="kmh-footer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="kmh-footer__accordion-content">
          <ul class="kmh-footer__link-list">
            <li><a href="/pages/about" class="kmh-footer__link">About KitchenMixHaven</a></li>
            <li><a href="/pages/recipes" class="kmh-footer__link">Recipes & Kitchen Tips</a></li>
            <li><a href="/pages/compare" class="kmh-footer__link">Appliance Comparison Matrix</a></li>
            <li><a href="/pages/configurator" class="kmh-footer__link">Mixer Studio Configurator</a></li>
            <li><a href="/blogs/news" class="kmh-footer__link">Culinary Articles & News</a></li>
          </ul>
        </div>
      </div>

      <!-- Column 5: LEGAL & POLICIES -->
      <div class="kmh-footer__col kmh-footer__accordion">
        <button class="kmh-footer__accordion-trigger" aria-expanded="false">
          <span class="kmh-footer__col-heading">Legal & Policies</span>
          <svg class="kmh-footer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="kmh-footer__accordion-content">
          <ul class="kmh-footer__link-list">
            {% if section.settings.menu_legal.links.size > 0 %}
              {% for link in section.settings.menu_legal.links %}
                <li><a href="{{ link.url }}" class="kmh-footer__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/policies/privacy-policy" class="kmh-footer__link">Privacy Policy</a></li>
              <li><a href="/policies/terms-of-service" class="kmh-footer__link">Terms of Service</a></li>
              <li><a href="/policies/refund-policy" class="kmh-footer__link">Refund Policy</a></li>
              <li><a href="/policies/shipping-policy" class="kmh-footer__link">Shipping Policy</a></li>
              <li><a href="/pages/warranty" class="kmh-footer__link">Product Warranty Information</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

    </nav>

    <!-- 4. Bottom Meta, Payment Badges & Copyright Strip -->
    <div class="kmh-footer__bottom">
      
      <div class="kmh-footer__copyright-group">
        <p class="kmh-footer__copyright">
          &copy; {{ 'now' | date: "%Y" }} <strong>KitchenMixHaven</strong>. All Rights Reserved.
        </p>
        <p class="kmh-footer__disclaimer">
          All brand names, trademarks, and registered trademarks mentioned are the property of their respective owners.
        </p>
      </div>

      {% if section.settings.show_payment_icons %}
        <!-- Payment Methods Vector Strip -->
        <div class="kmh-footer__payments" aria-label="Accepted Payment Methods">
          <span class="kmh-footer__payments-label">Payment Methods:</span>
          <div class="kmh-footer__payment-icons">
            
            <!-- VISA -->
            <span class="kmh-footer__payment-card" title="Visa">
              <svg width="38" height="24" viewBox="0 0 38 24" fill="none" role="img" aria-label="Visa">
                <rect width="38" height="24" rx="4" fill="#1A1F71"/>
                <path d="M15.4 16.5H13.2L14.6 7.5H16.8L15.4 16.5ZM21.2 7.7C20.8 7.5 20.1 7.4 19.3 7.4C17.2 7.4 15.7 8.5 15.7 10.1C15.7 11.3 16.8 11.9 17.6 12.3C18.4 12.7 18.7 13 18.7 13.4C18.7 14 18 14.5 17.2 14.5C16.4 14.5 15.8 14.3 15.2 14L14.9 13.9L14.6 15.8C15.2 16.1 16.3 16.3 17.4 16.3C19.7 16.3 21.1 15.2 21.1 13.4C21.1 12 20.2 11.2 19.1 10.7C18.4 10.3 18 10.1 18 9.7C18 9.3 18.4 8.9 19.3 8.9C20 8.9 20.5 9 20.9 9.2L21.2 7.7ZM26.4 7.5H24.7C24.2 7.5 23.8 7.7 23.6 8.2L20.2 16.5H22.5L23 15.2H25.8L26 16.5H28L26.4 7.5ZM23.6 13.5L24.7 10.4C24.7 10.4 24.9 9.8 25.1 9.3L25.3 10.4L25.6 13.5H23.6ZM11.6 7.5L9.5 13.7L9.3 12.6C8.9 11.2 7.7 9.7 6.4 9L8.3 16.5H10.6L14 7.5H11.6Z" fill="#FFFFFF"/>
                <path d="M7.7 7.5H4.2L4.1 7.7C6.8 8.4 8.6 10.2 9.3 12.6L8.5 8.3C8.4 7.8 8 7.5 7.7 7.5Z" fill="#F7B600"/>
              </svg>
            </span>

            <!-- Mastercard -->
            <span class="kmh-footer__payment-card" title="Mastercard">
              <svg width="38" height="24" viewBox="0 0 38 24" fill="none" role="img" aria-label="Mastercard">
                <rect width="38" height="24" rx="4" fill="#0A0A0A"/>
                <circle cx="15" cy="12" r="7" fill="#EB001B"/>
                <circle cx="23" cy="12" r="7" fill="#F79E1B"/>
                <path d="M19 6.8a6.96 6.96 0 0 1 2.6 5.2A6.96 6.96 0 0 1 19 17.2a6.96 6.96 0 0 1-2.6-5.2c0-2.1 1-4 2.6-5.2z" fill="#FF5F00"/>
              </svg>
            </span>

            <!-- American Express -->
            <span class="kmh-footer__payment-card" title="American Express">
              <svg width="38" height="24" viewBox="0 0 38 24" fill="none" role="img" aria-label="American Express">
                <rect width="38" height="24" rx="4" fill="#006FCF"/>
                <path d="M6 14.5L7.5 11.5L6 8.5H8.2L9.2 10.7L10.2 8.5H12.4L10.9 11.5L12.4 14.5H10.2L9.2 12.3L8.2 14.5H6ZM13.2 14.5V8.5H18.2C19.2 8.5 19.8 9.1 19.8 10.1V12.9C19.8 13.9 19.2 14.5 18.2 14.5H13.2ZM14.8 13H17.8C18.2 13 18.4 12.8 18.4 12.4V10.6C18.4 10.2 18.2 10 17.8 10H14.8V13ZM20.8 14.5V8.5H23.8C24.8 8.5 25.4 9.1 25.4 10.1V12.9C25.4 13.9 24.8 14.5 23.8 14.5H20.8ZM22.4 13H23.8C24.2 13 24.4 12.8 24.4 12.4V10.6C24.4 10.2 24.2 10 23.8 10H22.4V13Z" fill="#FFFFFF"/>
              </svg>
            </span>

            <!-- Discover -->
            <span class="kmh-footer__payment-card" title="Discover">
              <svg width="38" height="24" viewBox="0 0 38 24" fill="none" role="img" aria-label="Discover">
                <rect width="38" height="24" rx="4" fill="#FFFFFF"/>
                <path d="M5 14.2V9.8H7.2C8.7 9.8 9.6 10.7 9.6 12C9.6 13.3 8.7 14.2 7.2 14.2H5ZM6.2 13.2H7.2C8.1 13.2 8.6 12.7 8.6 12C8.6 11.3 8.1 10.8 7.2 10.8H6.2V13.2ZM10.8 14.2V9.8H12V14.2H10.8ZM13 13.4L13.6 12.7C14.1 13.2 14.8 13.4 15.5 13.4C16.1 13.4 16.4 13.2 16.4 12.9C16.4 12 14.2 12.3 14.2 10.8C14.2 10.1 14.8 9.7 15.6 9.7C16.4 9.7 17 10 17.5 10.4L16.9 11.1C16.5 10.8 16 10.6 15.6 10.6C15.1 10.6 14.8 10.8 14.8 11.1C14.8 11.9 17 11.7 17 13.1C17 13.8 16.4 14.3 15.5 14.3C14.5 14.3 13.7 13.9 13 13.4Z" fill="#111827"/>
                <circle cx="21" cy="12" r="4.2" fill="#F47216"/>
              </svg>
            </span>

            <!-- Apple Pay -->
            <span class="kmh-footer__payment-card" title="Apple Pay">
