<footer style="background-color: var(--kmh-navy); color: #F8FAFC; padding-top: 5rem; padding-bottom: 3rem; margin-top: 4rem; border-top: 1px solid rgba(212, 175, 55, 0.2);">
  <div class="kmh-container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 3rem; margin-bottom: 4rem;">
      
      <!-- Brand & Bio -->
      <div>
        <a href="/" class="kmh-logo" style="color: #FFFFFF; font-size: 1.8rem; margin-bottom: 1.2rem; display: inline-block;">
          KITCHEN<span style="color: var(--kmh-gold);">MIX</span>HAVEN
        </a>
        <p style="color: #94A3B8; font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.5rem;">
          KitchenMixHaven is your destination for ultra-premium kitchen appliances, commercial-grade stand mixers, high-precision espresso systems, and modern culinary tech.
        </p>
        <div style="display: flex; gap: 12px;">
          <a href="#" class="kmh-icon-btn" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: var(--kmh-gold);">IG</a>
          <a href="#" class="kmh-icon-btn" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: var(--kmh-gold);">FB</a>
          <a href="#" class="kmh-icon-btn" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: var(--kmh-gold);">YT</a>
        </div>
      </div>

      <!-- Quick Collections -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.2rem;">Collections</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: #CBD5E1;">
          <li><a href="/collections/stand-mixers" style="color: inherit;">Stand Mixers & Accessories</a></li>
          <li><a href="/collections/coffee-espresso" style="color: inherit;">Espresso & Grinders</a></li>
          <li><a href="/collections/blenders" style="color: inherit;">Professional Blenders</a></li>
          <li><a href="/collections/air-fryers" style="color: inherit;">Multi-Oven & Air Fryers</a></li>
          <li><a href="/pages/sale" style="color: var(--kmh-gold); font-weight: 600;">Flash Sale & Clearance</a></li>
        </ul>
      </div>

      <!-- Customer Support -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.2rem;">Customer Care</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: #CBD5E1;">
          <li><a href="/pages/about" style="color: inherit;">About KitchenMixHaven</a></li>
          <li><a href="/pages/contact" style="color: inherit;">Contact Support & Showroom</a></li>
          <li><a href="/pages/compare" style="color: inherit;">Appliance Comparison Matrix</a></li>
          <li><a href="/pages/gift-guide" style="color: inherit;">Curated Gift Guide</a></li>
          <li><a href="/pages/faq" style="color: inherit;">Warranty & 30-Day Returns</a></li>
        </ul>
      </div>

      <!-- Newsletter Join -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 0.8rem; font-size: 1.2rem;">Culinary Insider</h4>
        <p style="color: #94A3B8; font-size: 0.85rem; margin-bottom: 1.2rem;">Subscribe to receive exclusive appliance drops, chef recipes, and 10% off your first luxury mixer.</p>
        <form onsubmit="event.preventDefault(); alert('Thank you for subscribing to KitchenMixHaven!');" style="display: flex; gap: 8px;">
          <input type="email" placeholder="Enter your email..." required style="padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: #FFFFFF; flex-grow: 1; font-size: 0.85rem;">
          <button type="submit" class="kmh-btn kmh-btn-gold kmh-btn-sm" style="border-radius: 8px;">Join</button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.8rem; color: #94A3B8;">
      <div>
        &copy; {{ 'now' | date: "%Y" }} KitchenMixHaven Inc. All Rights Reserved. Designed for Exceptional Cooking.
      </div>
      <div style="display: flex; gap: 1.5rem;">
        <a href="#" style="color: inherit;">Privacy Policy</a>
        <a href="#" style="color: inherit;">Terms of Service</a>
        <a href="#" style="color: inherit;">Shipping Policy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
