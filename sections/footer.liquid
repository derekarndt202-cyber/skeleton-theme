  /* ==========================================================================
     Responsive Breakpoints
     ========================================================================== */
  @media (max-width: 1024px) {
    .kmh-footer__trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .kmh-footer__newsletter-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .kmh-footer__nav-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .kmh-footer__col--brand {
      grid-column: span 3;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 768px) {
    .kmh-footer {
      padding-top: 3.5rem;
      margin-top: 3.5rem;
    }

    .kmh-footer__trust-grid {
      grid-template-columns: 1fr;
    }

    .kmh-footer__nav-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 2.5rem;
    }

    .kmh-footer__col--brand {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Accordion Behavior on Mobile */
    .kmh-footer__accordion {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .kmh-footer__accordion-trigger {
      cursor: pointer;
      padding: 1.2rem 0;
    }

    .kmh-footer__accordion-trigger .kmh-footer__col-heading {
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .kmh-footer__accordion-trigger .kmh-footer__col-heading::after {
      display: none;
    }

    .kmh-footer__accordion-icon {
      display: block;
      color: var(--kmh-gold);
      transition: transform 0.3s ease;
    }

    .kmh-footer__accordion.is-open .kmh-footer__accordion-icon {
      transform: rotate(180deg);
    }

    .kmh-footer__accordion-content {
      display: none;
      padding-bottom: 1.2rem;
    }

    .kmh-footer__accordion.is-open .kmh-footer__accordion-content {
      display: block;
    }

    .kmh-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .kmh-footer__input-row {
      flex-direction: column;
    }

    .kmh-footer__submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  // Mobile accordion functionality for footer columns
  document.addEventListener('DOMContentLoaded', function() {
    var triggers = document.querySelectorAll('.kmh-footer__accordion-trigger');
    
    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        if (window.innerWidth <= 768) {
          var parent = this.closest('.kmh-footer__accordion');
          var isExpanded = this.getAttribute('aria-expanded') === 'true';
          
          this.setAttribute('aria-expanded', !isExpanded);
          parent.classList.toggle('is-open');
        }
      });
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 768) {
        triggers.forEach(function(trigger) {
          trigger.setAttribute('aria-expanded', 'false');
          var parent = trigger.closest('.kmh-footer__accordion');
          if (parent) {
            parent.classList.remove('is-open');
          }
        });
      }
    });
  });
</script>

