        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">Shop Categories</h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          <li><a href="/collections/stand-mixers" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Stand Mixers & Attachments</a></li>
          <li><a href="/collections/coffee-espresso" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Espresso & Coffee Grinders</a></li>
          <li><a href="/collections/blenders" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Professional High-Speed Blenders</a></li>
          <li><a href="/collections/air-fryers" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Multi-Ovens & Air Fryers</a></li>
