    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: var(--kmh-transition);
  }

  .kmh-footer__trust-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(212, 175, 55, 0.35);
