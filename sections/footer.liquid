<footer class="kmh-footer" style="background: linear-gradient(180deg, #0B132B 0%, #060A17 100%); color: #F8FAFC; padding-top: 5rem; padding-bottom: 2.5rem; margin-top: 5rem; border-top: 1px solid rgba(212, 175, 55, 0.25); position: relative; overflow: hidden;">

  <!-- Ambient Decorative Glow -->
  <div style="position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 600px; height: 200px; background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.08) 0%, rgba(11, 19, 43, 0) 70%); pointer-events: none;"></div>

  <div class="kmh-container">

    <!-- Trust Badges & Guarantee Strip -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; padding-bottom: 3.5rem; margin-bottom: 3.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🚚</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Shipping Available</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Free shipping on orders $150+</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🔒</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Secure Checkout</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Encrypted & protected payments</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🔄</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Easy Returns</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Straightforward return policy</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">💬</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Customer Support</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Assistance for your orders</p>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2.5rem; margin-bottom: 4rem;">
      
      <!-- Brand Column -->
      <div style="grid-column: span 1.2;">
        <a href="/" class="kmh-logo" style="display: inline-flex; align-items: center; gap: 10px; margin-bottom: 1.2rem; text-decoration: none;">
          <img src="{{ 'favicon.jpg' | asset_url }}" alt="KitchenMixHaven Emblem" style="height: 42px; width: 42px; border-radius: 10px; box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2); border: 1.5px solid var(--kmh-gold); object-fit: cover;">
          <span style="font-family: var(--font-heading); color: #FFFFFF; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.05em;">
            KitchenMixHaven
          </span>
        </a>
        <p style="color: #94A3B8; font-size: 0.88rem; line-height: 1.7; margin-bottom: 1.5rem; max-width: 300px;">
          Kitchen appliances and tools designed to make everyday cooking, baking, and meal preparation easier.
        </p>

        <!-- Social Media Icons -->
        <div style="display: flex; gap: 10px;">
          <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="kmh-icon-btn" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); color: var(--kmh-gold); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="kmh-icon-btn" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); color: var(--kmh-gold); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="kmh-icon-btn" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); color: var(--kmh-gold); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.17 2.54 7.74 6.14 9.22-.08-.77-.16-1.97.03-2.82.18-.77 1.15-4.88 1.15-4.88s-.3-.59-.3-1.46c0-1.37.8-2.39 1.79-2.39.84 0 1.25.63 1.25 1.39 0 .85-.54 2.12-.82 3.3-.23.98.49 1.78 1.45 1.78 1.74 0 3.08-1.84 3.08-4.49 0-2.35-1.69-3.99-4.1-3.99-2.79 0-4.43 2.09-4.43 4.26 0 .84.32 1.74.73 2.24.08.1.09.19.07.29-.07.31-.24.97-.27 1.1-.04.18-.15.22-.34.13-1.28-.59-2.08-2.46-2.08-3.96 0-3.23 2.35-6.19 6.77-6.19 3.55 0 6.32 2.53 6.32 5.92 0 3.53-2.22 6.37-5.31 6.37-1.04 0-2.01-.54-2.35-1.18l-.64 2.44c-.23.89-.86 2.01-1.28 2.7C9.35 21.84 10.64 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
          </a>
        </div>
      </div>

      <!-- Group 1: SHOP -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">
          {{ section.settings.menu_categories.title | default: "Shop" }}
        </h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          {% if section.settings.menu_categories.links.size > 0 %}
            {% for link in section.settings.menu_categories.links %}
              <li><a href="{{ link.url }}" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/collections/all" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Shop All</a></li>
            <li><a href="/collections/stand-mixers" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Stand Mixers</a></li>
            <li><a href="/collections/hand-mixers" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Hand Mixers</a></li>
            <li><a href="/collections/air-fryers" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Air Fryers</a></li>
            <li><a href="/collections/toasters" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Toasters</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Group 2: CUSTOMER SUPPORT -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">
          {{ section.settings.menu_support.title | default: "Customer Support" }}
        </h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          {% if section.settings.menu_support.links.size > 0 %}
            {% for link in section.settings.menu_support.links %}
              <li><a href="{{ link.url }}" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/contact" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Contact Us</a></li>
            <li><a href="/pages/faq" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">FAQ</a></li>
            <li><a href="/policies/shipping-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Shipping & Delivery</a></li>
            <li><a href="/policies/refund-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Returns & Refunds</a></li>
            <li><a href="/pages/order-tracking" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Order Tracking</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Group 3: COMPANY -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">
          Company
        </h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          <li><a href="/pages/about" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">About Us</a></li>
          <li><a href="/pages/recipes" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Recipes</a></li>
          <li><a href="/blogs/news" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Kitchen Tips</a></li>
        </ul>
      </div>

      <!-- Group 4: LEGAL -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">
          {{ section.settings.menu_legal.title | default: "Legal" }}
        </h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          {% if section.settings.menu_legal.links.size > 0 %}
            {% for link in section.settings.menu_legal.links %}
              <li><a href="{{ link.url }}" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/policies/privacy-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Terms of Service</a></li>
            <li><a href="/pages/warranty" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Warranty Details</a></li>
          {% endif %}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar & Copyright -->
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; font-size: 0.82rem; color: #94A3B8;">
      <div>
        &copy; {{ 'now' | date: "%Y" }} <strong>KitchenMixHaven</strong>. All Rights Reserved.
      </div>

      <!-- Accepted Payment Badges -->
      <div style="display: flex; align-items: center; gap: 10px; font-size: 0.75rem; color: #64748B;">
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">VISA</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">MC</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">AMEX</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">APPLE PAY</span>
        <span style="background: rgba(255,255,255,0.08); padding: 4px 8px; border-radius: 4px; color: #CBD5E1; font-weight: 600;">SHOP PAY</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_categories",
      "label": "Categories Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Customer Support Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_legal",
      "label": "Legal & Policies Menu",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
