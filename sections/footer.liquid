          <li><a href="/pages/faq" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Warranty & 30-Day Returns</a></li>
          <li><a href="/pages/recipes" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Chef Recipes & Inspiration</a></li>
        </ul>
      </div>

      <!-- Legal & Policies Menu -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">Legal & Policies</h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          <li><a href="/policies/privacy-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Terms of Service</a></li>
          <li><a href="/policies/shipping-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Shipping & Delivery Policy</a></li>
          <li><a href="/policies/refund-policy" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Refund & Return Policy</a></li>
          <li><a href="/pages/cookie-settings" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Cookie Preferences</a></li>
          <li><a href="/pages/accessibility" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Accessibility Statement</a></li>
        </ul>
      </div>

      <!-- Newsletter Join Column -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 0.8rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">Culinary VIP Insider</h4>
        <p style="color: #94A3B8; font-size: 0.85rem; margin-bottom: 1.2rem; line-height: 1.5;">Subscribe for secret appliance drops, chef recipes, and <strong>10% off</strong> your first luxury stand mixer.</p>
        <form onsubmit="event.preventDefault(); alert('Welcome to the Culinary Insider VIP list!');" style="display: flex; flex-direction: column; gap: 10px;">
          <input type="email" placeholder="Enter your email address..." required style="padding: 0.8rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.06); color: #FFFFFF; font-size: 0.85rem; outline: none;">
