          <li><a href="/pages/sale" style="color: #FF6B6B; text-decoration: none; font-weight: 600;">🔥 Clearance & Flash Deals</a></li>
        </ul>
      </div>

      <!-- Customer Support Menu -->
      <div>
        <h4 style="font-family: var(--font-heading); color: #FFFFFF; margin-bottom: 1.2rem; font-size: 1.1rem; letter-spacing: 0.03em; border-left: 3px solid var(--kmh-gold); padding-left: 10px;">Customer Care</h4>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: #CBD5E1;">
          <li><a href="/pages/about" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">About KitchenMixHaven</a></li>
          <li><a href="/pages/contact" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Contact Support & Showroom</a></li>
          <li><a href="/pages/compare" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--kmh-gold)'" onmouseout="this.style.color='inherit'">Appliance Comparison Matrix</a></li>
