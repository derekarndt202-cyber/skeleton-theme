      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🚚</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Free White-Glove Delivery</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">On all orders over $150</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🛡️</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">5-Year Craft Warranty</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Guaranteed performance & parts</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">🔄</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">30-Day Risk Free Trial</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">Hassle-free kitchen returns</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 1.8rem; color: var(--kmh-gold);">💬</div>
        <div>
          <h5 style="color: #FFFFFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem;">Concierge Support</h5>
          <p style="color: #94A3B8; font-size: 0.8rem; margin: 0;">24/7 Culinary expert assistance</p>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 3rem; margin-bottom: 4rem;">
      
      <!-- Brand Column -->
      <div style="grid-column: span 1.5;">
        <a href="/" class="kmh-logo" style="display: inline-flex; align-items: center; gap: 10px; margin-bottom: 1.2rem; text-decoration: none;">
          <img src="{{ 'favicon.jpg' | asset_url }}" alt="KitchenMixHaven Emblem" style="height: 42px; width: 42px; border-radius: 10px; box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2); border: 1.5px solid var(--kmh-gold); object-fit: cover;">
          <span style="font-family: var(--font-heading); color: #FFFFFF; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.05em;">
            KITCHEN<span style="color: var(--kmh-gold);">MIX</span>HAVEN
          </span>
        </a>
        <p style="color: #94A3B8; font-size: 0.88rem; line-height: 1.7; margin-bottom: 1.5rem; max-width: 320px;">
