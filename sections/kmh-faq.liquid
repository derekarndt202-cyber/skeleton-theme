<section class="kmh-faq" style="--kmh-accent: {{ section.settings.accent_color }}; --kmh-surface: {{ section.settings.surface_color }};">
  <div class="kmh-faq__heading">
    <p>{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="kmh-faq__items">
    {% for block in section.blocks %}
      <details class="kmh-faq-item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <div>{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .kmh-faq { padding: 4rem 0; }
  .kmh-faq__heading { max-width: 760px; margin-bottom: 1.5rem; }
  .kmh-faq__heading p { color: var(--kmh-accent); font-size: .78rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; margin-bottom: .75rem; }
  .kmh-faq__heading h2 { font-size: clamp(2rem, 5vw, 4.25rem); line-height: .95; }
  .kmh-faq__items { display: grid; gap: .85rem; }
  .kmh-faq-item { border-radius: 1.2rem; border: 1px solid rgba(32,25,21,.1); background: var(--kmh-surface); box-shadow: 0 14px 40px rgba(32,25,21,.06); overflow: hidden; }
  .kmh-faq-item summary { cursor: pointer; list-style: none; padding: 1.1rem 1.25rem; font-weight: 900; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .kmh-faq-item summary::-webkit-details-marker { display: none; }
  .kmh-faq-item summary::after { content: '+'; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: #fff; color: var(--kmh-accent); flex: 0 0 auto; }
  .kmh-faq-item[open] summary::after { content: '–'; }
  .kmh-faq-item div { padding: 0 1.25rem 1.25rem; line-height: 1.7; color: rgba(32,25,21,.72); }
{% endstylesheet %}

{% schema %}
{
  "name": "KMH FAQ",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ff6a3d" },
    { "type": "color", "id": "surface_color", "label": "Answer card color", "default": "#fff7ef" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mixer FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions before you mix?" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Which mixer is best for bread dough?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Look for a stable stand mixer with enough bowl capacity and torque for dense dough. If you bake often, prioritize durability and attachments.</p>" }
    ] }
  ],
  "presets": [
    { "name": "KMH FAQ", "blocks": [
      { "type": "question", "settings": { "question": "Which mixer is best for bread dough?", "answer": "<p>Look for a stable stand mixer with enough bowl capacity and torque for dense dough. If you bake often, prioritize durability and attachments.</p>" } },
      { "type": "question", "settings": { "question": "Do I need a stand mixer or hand mixer?", "answer": "<p>Choose a hand mixer for quick, light jobs. Choose a stand mixer for frequent baking, heavy dough, larger batches, and hands-free mixing.</p>" } },
      { "type": "question", "settings": { "question": "How do attachments change what a mixer can do?", "answer": "<p>Attachments can turn a mixer into a pasta roller, grinder, slicer, or prep station. Check compatibility before buying.</p>" } },
      { "type": "question", "settings": { "question": "Can I edit this FAQ in Shopify?", "answer": "<p>Yes. Add, remove, reorder, or rewrite each question from the Shopify theme editor.</p>" } }
    ] }
  ]
}
{% endschema %}
