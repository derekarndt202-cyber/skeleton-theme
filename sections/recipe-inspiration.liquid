<div class="kmh-section-padding" style="background-color: var(--kmh-bg-light);">
  <div class="kmh-container">
    
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 3rem;">
      <div>
        <span class="kmh-subtitle">Kitchen Inspiration</span>
        <h2 class="kmh-title" style="margin-bottom: 0;">Recipes & Kitchen Tips</h2>
      </div>
      <a href="/pages/recipes" class="kmh-btn kmh-btn-secondary">View All Recipes &rarr;</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
      
      {% assign recipes = "Artisan Sourdough Boule|French Caramel Mousse|Handmade Tagliatelle Pasta" | split: "|" %}
      {% assign times = "45 mins prep • 4 hrs proof|25 mins prep • 2 hrs chill|30 mins prep • 10 mins cook" | split: "|" %}
      {% assign levels = "Baking|Dessert|Pasta" | split: "|" %}

      {% for title in recipes %}
        {% assign idx = forloop.index0 %}
        <div class="kmh-card">
          <div style="position: relative; padding-top: 60%; background: var(--kmh-navy); overflow: hidden;">
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(15,23,42,0.85) 100%); display: flex; align-items: flex-end; padding: 1.25rem;">
              <span class="kmh-badge kmh-badge--sale" style="position: absolute; top: 12px; left: 12px; background: var(--kmh-gold); color: var(--kmh-navy);">
                {{ levels[idx] }}
              </span>
              <span style="color: #FFFFFF; font-size: 0.8rem; font-weight: 500;">
                ⏱ {{ times[idx] }}
              </span>
            </div>
          </div>

          <div style="padding: 1.5rem;">
            <h3 style="font-family: var(--font-heading); font-size: 1.2rem; margin-bottom: 0.6rem; color: var(--kmh-navy);">{{ title }}</h3>
            <p style="font-size: 0.88rem; color: #64748B; margin-bottom: 1.2rem;">Step-by-step baking techniques and mixing guidelines for your home kitchen.</p>
            <a href="/pages/recipes" style="font-weight: 700; color: var(--kmh-navy); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 6px;">
              View Full Recipe <span style="color: var(--kmh-gold);">&rarr;</span>
            </a>
          </div>
        </div>
      {% endfor %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Recipes & Kitchen Tips",
  "settings": [],
  "presets": [
    { "name": "Recipes & Kitchen Tips" }
  ]
}
{% endschema %}
