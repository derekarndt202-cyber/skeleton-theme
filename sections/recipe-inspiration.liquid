<div class="kmh-section-padding" style="background-color: {{ section.settings.background_color | default: 'var(--kmh-bg-light)' }};">
  <div class="kmh-container">
    
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 3rem;">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="kmh-subtitle">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="kmh-title" style="margin-bottom: 0;">{{ section.settings.heading | default: "Chef-Tested Recipes" }}</h2>
      </div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '/pages/recipes' }}" class="kmh-btn kmh-btn-secondary">
          {{ section.settings.button_label }} &rarr;
        </a>
      {% endif %}
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
      
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="kmh-card" {{ block.shopify_attributes }}>
            <div style="position: relative; padding-top: 65%; background: var(--kmh-navy); overflow: hidden;">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
              {% endif %}
              <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(15,23,42,0.85) 100%); display: flex; align-items: flex-end; padding: 1.25rem;">
                <span class="kmh-badge kmh-badge--sale" style="position: absolute; top: 12px; left: 12px; background: var(--kmh-gold); color: var(--kmh-navy);">
                  {{ block.settings.difficulty | default: 'Easy' }}
                </span>
                <span style="color: #FFFFFF; font-size: 0.8rem; font-weight: 500;">
                  ⏱ {{ block.settings.time | default: '30 mins' }}
                </span>
              </div>
            </div>

            <div style="padding: 1.5rem;">
              <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.8rem; color: var(--kmh-navy);">{{ block.settings.title }}</h3>
              <p style="font-size: 0.88rem; color: #64748B; margin-bottom: 1.2rem;">{{ block.settings.text }}</p>
              <a href="{{ block.settings.link | default: '/pages/recipes' }}" style="font-weight: 700; color: var(--kmh-navy); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 6px;">
                View Recipe <span style="color: var(--kmh-gold);">&rarr;</span>
              </a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Presets -->
        {% assign recipes = "Artisan Sourdough Boule|Silky French Salted Caramel Mousse|Handcrafted Tagliatelle Pasta|Espresso Affogato Gelato" | split: "|" %}
        {% assign times = "45 mins prep • 4 hrs proof|25 mins prep • 2 hrs chill|30 mins prep • 10 mins cook|15 mins prep" | split: "|" %}
        {% assign levels = "Intermediate|Easy|Master Chef|Easy" | split: "|" %}

        {% for title in recipes %}
          {% assign idx = forloop.index0 %}
          <div class="kmh-card">
            <div style="position: relative; padding-top: 65%; background: var(--kmh-navy); overflow: hidden;">
              <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(15,23,42,0.85) 100%); display: flex; align-items: flex-end; padding: 1.25rem;">
                <span class="kmh-badge kmh-badge--sale" style="position: absolute; top: 12px; left: 12px; background: var(--kmh-gold); color: var(--kmh-navy);">
                  {{ levels[idx] }}
                </span>
                <span style="color: #FFFFFF; font-size: 0.8rem; font-weight: 500;">
                  ⏱ {{ times[idx] }}
                </span>
              </div>
            </div>

            <div style="padding: 1.5rem;">
              <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.8rem; color: var(--kmh-navy);">{{ title }}</h3>
              <p style="font-size: 0.88rem; color: #64748B; margin-bottom: 1.2rem;">Designed specifically for KitchenMixHaven planetary stand mixers and stainless attachments.</p>
              <a href="/pages/recipes" style="font-weight: 700; color: var(--kmh-navy); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 6px;">
                View Full Recipe <span style="color: var(--kmh-gold);">&rarr;</span>
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Recipe Inspiration",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Subtitle", "default": "Kitchen Test Lab" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Chef-Tested Recipes" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Explore Recipe Index" },
    { "type": "url", "id": "button_link", "label": "Button Link", "default": "/pages/recipes" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#F8FAFC" }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Recipe Title", "default": "Artisan Sourdough Boule" },
        { "type": "text", "id": "time", "label": "Cook/Prep Time", "default": "45 mins prep" },
        { "type": "text", "id": "difficulty", "label": "Difficulty Badge", "default": "Intermediate" },
        { "type": "textarea", "id": "text", "label": "Short Description", "default": "Designed for KitchenMixHaven planetary stand mixers." },
        { "type": "image_picker", "id": "image", "label": "Recipe Cover Image" },
        { "type": "url", "id": "link", "label": "Recipe Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Inspiration",
      "blocks": [
        { "type": "recipe", "settings": { "title": "Artisan Sourdough Boule", "time": "45 mins prep", "difficulty": "Intermediate" } },
        { "type": "recipe", "settings": { "title": "Silky French Salted Caramel Mousse", "time": "25 mins prep", "difficulty": "Easy" } }
      ]
    }
  ]
}
{% endschema %}
