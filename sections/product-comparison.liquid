<div class="kmh-section-padding">
  <div class="kmh-container">
    
    <div class="kmh-section-header">
      <span class="kmh-subtitle">Side-by-Side Analysis</span>
      <h2 class="kmh-title">Appliance Specification Matrix</h2>
      <p class="kmh-description">Compare motor output, bowl volume, warranty coverage, and ratings across our premier stand mixers.</p>
    </div>

    <div style="overflow-x: auto; background: #FFFFFF; border-radius: var(--radius-card); border: 1px solid var(--kmh-border); box-shadow: var(--kmh-shadow-subtle);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--kmh-border); background: var(--kmh-bg-light);">
            <th style="padding: 1.5rem; width: 22%; font-family: var(--font-heading); font-size: 1.1rem; color: var(--kmh-navy);">Features</th>
            <th style="padding: 1.5rem; text-align: center; width: 26%;">
              <div style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--kmh-navy);">Artisan 7.5QT Pro</div>
              <span class="kmh-badge kmh-badge--bestseller" style="margin-top: 4px;">Flagship</span>
            </th>
            <th style="padding: 1.5rem; text-align: center; width: 26%;">
              <div style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--kmh-navy);">Classic 5.5QT Home</div>
              <span class="kmh-badge kmh-badge--new" style="margin-top: 4px;">Popular</span>
            </th>
            <th style="padding: 1.5rem; text-align: center; width: 26%;">
              <div style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--kmh-navy);">Compact 3.8QT Prep</div>
              <span class="kmh-badge kmh-badge--sale" style="margin-top: 4px;">Space Saver</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Motor Power</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; font-weight: 700; color: var(--kmh-gold);">750 Watts High-Torque</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">500 Watts AC Motor</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">350 Watts Direct Drive</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Bowl Capacity</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">7.5 Quarts (Double Batch)</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">5.5 Quarts (Standard)</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">3.8 Quarts (Compact)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Housing Construction</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">Full Metal Die-Cast</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">Die-Cast Zinc Alloy</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">Reinforced Aluminum</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Warranty Coverage</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; font-weight: 700; color: var(--kmh-success);">5-Year Full Coverage</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">3-Year Motor Warranty</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center;">2-Year Warranty</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Rating</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; color: var(--kmh-gold);">★★★★★ (4.9/5)</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; color: var(--kmh-gold);">★★★★★ (4.8/5)</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; color: var(--kmh-gold);">★★★★☆ (4.7/5)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--kmh-border);">
            <td style="padding: 1.2rem 1.5rem; font-weight: 600;">Price</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; font-size: 1.3rem; font-weight: 700; color: var(--kmh-navy);">$499.00</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; font-size: 1.3rem; font-weight: 700; color: var(--kmh-navy);">$349.00</td>
            <td style="padding: 1.2rem 1.5rem; text-align: center; font-size: 1.3rem; font-weight: 700; color: var(--kmh-navy);">$199.00</td>
          </tr>
          <tr>
            <td style="padding: 1.5rem;"></td>
            <td style="padding: 1.5rem; text-align: center;">
              <button class="kmh-btn kmh-btn-gold kmh-btn-sm" style="width: 100%;" onclick="KMH_OpenCart()">Select Artisan Pro</button>
            </td>
            <td style="padding: 1.5rem; text-align: center;">
              <button class="kmh-btn kmh-btn-primary kmh-btn-sm" style="width: 100%;" onclick="KMH_OpenCart()">Select Classic</button>
            </td>
            <td style="padding: 1.5rem; text-align: center;">
              <button class="kmh-btn kmh-btn-secondary kmh-btn-sm" style="width: 100%;" onclick="KMH_OpenCart()">Select Compact</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Comparison",
  "settings": [],
  "presets": [
    { "name": "Product Comparison" }
  ]
}
{% endschema %}
