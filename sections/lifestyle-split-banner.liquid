<div class="kmh-section-padding" style="background-color: var(--kmh-bg-light); border-bottom: 1px solid var(--kmh-border);">
  <div class="kmh-container">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
      
      <!-- Lifestyle Visual Block -->
      <div style="position: relative;">
        <div style="border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--kmh-shadow-hover); border: 1px solid var(--kmh-border); position: relative; padding-top: 75%; background: var(--kmh-navy);">
          <div style="position: absolute; inset:0; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(15,23,42,0.9) 100%);">
            <span style="color: var(--kmh-gold); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;">Design & Craftsmanship</span>
            <h3 style="font-family: var(--font-heading); color: #FFFFFF; font-size: 1.8rem; margin: 0.4rem 0;">Built for Generations of Bakers</h3>
          </div>
        </div>
      </div>

      <!-- Text Block -->
      <div>
        <span class="kmh-subtitle">High Performance Heritage</span>
        <h2 class="kmh-title" style="font-size: clamp(2rem, 3.5vw, 3rem);">The Kitchen Starts Here.</h2>
        
        <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 1.5rem;">
          Whether you are kneading high-hydration sourdough bread, whipping silky Italian meringues, or grinding custom coffee roasts, KitchenMixHaven tools bring culinary precision into your home.
        </p>

        <ul style="list-style: none; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 10px; font-weight: 600; color: var(--kmh-navy);">
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--kmh-gold);">✓</span> Commercial grade 750W planetary motor
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--kmh-gold);">✓</span> Ultra-quiet silent drive technology (< 62dB)
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--kmh-gold);">✓</span> Dishwasher safe stainless steel accessories
          </li>
        </ul>

        <a href="/collections/all" class="kmh-btn kmh-btn-primary">
          Explore Flagship Mixers &rarr;
        </a>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Lifestyle Split Banner",
  "settings": [],
  "presets": [
    { "name": "Lifestyle Split Banner" }
  ]
}
{% endschema %}
