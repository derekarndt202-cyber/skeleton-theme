<div class="kmh-section-padding" style="background-color: {{ section.settings.background_color | default: 'var(--kmh-bg-light)' }}; border-bottom: 1px solid var(--kmh-border);">
  <div class="kmh-container">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
      
      <!-- Lifestyle Visual Block -->
      <div style="position: relative; {% if section.settings.image_position == 'right' %}order: 2;{% endif %}">
        <div style="border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--kmh-shadow-hover); border: 1px solid var(--kmh-border); position: relative; padding-top: 75%; background: var(--kmh-navy);">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" style="position: absolute; inset:0; width:100%; height:100%; object-fit: cover;">
          {% endif %}
          <div style="position: absolute; inset:0; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(15,23,42,0.9) 100%);">
            {% if section.settings.overlay_eyebrow != blank %}
              <span style="color: var(--kmh-gold); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;">{{ section.settings.overlay_eyebrow }}</span>
            {% endif %}
            <h3 style="font-family: var(--font-heading); color: #FFFFFF; font-size: 1.8rem; margin: 0.4rem 0;">{{ section.settings.overlay_heading | default: "Built for Generations of Bakers" }}</h3>
          </div>
        </div>
      </div>

      <!-- Text Block -->
      <div style="{% if section.settings.image_position == 'right' %}order: 1;{% endif %}">
        {% if section.settings.eyebrow != blank %}
          <span class="kmh-subtitle">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="kmh-title" style="font-size: clamp(2rem, 3.5vw, 3rem);">{{ section.settings.heading | default: "The Kitchen Starts Here." }}</h2>
        
        <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 1.5rem;">
          {{ section.settings.text | default: "Whether you are kneading high-hydration sourdough bread, whipping silky Italian meringues, or grinding custom coffee roasts, KitchenMixHaven tools bring culinary precision into your home." }}
        </p>

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="kmh-btn kmh-btn-primary">
            {{ section.settings.button_label }} &rarr;
          </a>
        {% endif %}
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Lifestyle Split Banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Subtitle", "default": "High Performance Heritage" },
    { "type": "text", "id": "heading", "label": "Main Heading", "default": "The Kitchen Starts Here." },
    { "type": "textarea", "id": "text", "label": "Body Description", "default": "Whether you are kneading high-hydration sourdough bread, whipping silky Italian meringues, or grinding custom coffee roasts, KitchenMixHaven tools bring culinary precision into your home." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Explore Flagship Mixers" },
    { "type": "url", "id": "button_link", "label": "Button Link", "default": "/collections/all" },
    { "type": "image_picker", "id": "image", "label": "Banner Image" },
    { "type": "text", "id": "overlay_eyebrow", "label": "Image Badge Text", "default": "Design & Craftsmanship" },
    { "type": "text", "id": "overlay_heading", "label": "Image Card Overlay Heading", "default": "Built for Generations of Bakers" },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#F8FAFC" }
  ],
  "presets": [
    { "name": "Lifestyle Split Banner" }
  ]
}
{% endschema %}
