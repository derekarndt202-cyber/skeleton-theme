<div class="kmh-section-padding" style="background-color: {{ section.settings.background_color | default: 'transparent' }};">
  <div class="kmh-container">
    
    <div class="kmh-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="kmh-subtitle">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="kmh-title">{{ section.settings.heading | default: "Customer Reviews" }}</h2>
      {% if section.settings.description != blank %}
        <p class="kmh-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div>
      {% if section.blocks.size > 0 %}
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
          {% for block in section.blocks %}
            <div class="kmh-card" style="padding: 2rem;" {{ block.shopify_attributes }}>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                <div class="kmh-rating" style="font-size: 1.1rem;">★★★★★</div>
                {% if block.settings.is_verified %}
                  <span class="kmh-badge" style="background: rgba(22, 163, 74, 0.1); color: var(--kmh-success); border: 1px solid var(--kmh-success);">Verified Purchase</span>
                {% endif %}
              </div>
              <p style="font-size: 0.95rem; color: #334155; line-height: 1.7; margin-bottom: 1.5rem;">
                "{{ block.settings.quote }}"
              </p>
              <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 42px; height: 42px; border-radius: 50%; background: var(--kmh-navy); color: var(--kmh-gold); font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;">
                  {{ block.settings.author_initials | default: "KM" }}
                </div>
                <div>
                  <div style="font-weight: 700; color: var(--kmh-navy); font-size: 0.95rem;">{{ block.settings.author_name }}</div>
                  {% if block.settings.author_title != blank %}
                    <div style="font-size: 0.78rem; color: #64748B;">{{ block.settings.author_title }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <!-- Genuine State Fallback -->
        <div class="kmh-card" style="padding: 3rem 2rem; text-align: center; max-width: 600px; margin: 0 auto;">
          <div style="font-size: 2.5rem; margin-bottom: 0.8rem; color: var(--kmh-gold);">★</div>
          <h3 style="font-family: var(--font-heading); color: var(--kmh-navy); font-size: 1.4rem; margin-bottom: 0.5rem;">Customer Reviews Coming Soon</h3>
          <p style="color: #64748B; font-size: 0.92rem; line-height: 1.6; margin: 0;">We collect honest feedback directly from verified store orders. Check back soon for authentic customer experiences.</p>
        </div>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Subtitle", "default": "Reviews & Feedback" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Customer Reviews" },
    { "type": "textarea", "id": "description", "label": "Section Description", "default": "Read genuine feedback from home bakers and kitchen cooks." },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Verified Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review Quote Text" },
        { "type": "text", "id": "author_name", "label": "Author Name" },
        { "type": "text", "id": "author_title", "label": "Product Purchased / Subtitle" },
        { "type": "text", "id": "author_initials", "label": "Initials" },
        { "type": "checkbox", "id": "is_verified", "label": "Show Verified Purchase", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
