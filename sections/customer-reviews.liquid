<div class="kmh-section-padding" style="background-color: {{ section.settings.background_color | default: 'transparent' }};">
  <div class="kmh-container">
    
    <div class="kmh-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="kmh-subtitle">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="kmh-title">{{ section.settings.heading | default: "Loved by 100,000+ Kitchens" }}</h2>
      {% if section.settings.description != blank %}
        <p class="kmh-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
      
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="kmh-card" style="padding: 2rem;" {{ block.shopify_attributes }}>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <div class="kmh-rating" style="font-size: 1.1rem;">★★★★★</div>
              {% if block.settings.is_verified %}
                <span class="kmh-badge" style="background: rgba(22, 163, 74, 0.1); color: var(--kmh-success); border: 1px solid var(--kmh-success);">✓ Verified Buyer</span>
              {% endif %}
            </div>
            <p style="font-size: 1rem; color: #334155; font-style: italic; line-height: 1.7; margin-bottom: 1.5rem;">
              "{{ block.settings.quote }}"
            </p>
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--kmh-navy); color: var(--kmh-gold); font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading);">
                {{ block.settings.author_initials | default: "KM" }}
              </div>
              <div>
                <div style="font-weight: 700; color: var(--kmh-navy);">{{ block.settings.author_name }}</div>
                <div style="font-size: 0.78rem; color: #64748B;">{{ block.settings.author_title }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Review Presets -->
        <div class="kmh-card" style="padding: 2rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <div class="kmh-rating" style="font-size: 1.1rem;">★★★★★</div>
            <span class="kmh-badge" style="background: rgba(22, 163, 74, 0.1); color: var(--kmh-success); border: 1px solid var(--kmh-success);">✓ Verified Buyer</span>
          </div>
          <p style="font-size: 1rem; color: #334155; font-style: italic; line-height: 1.7; margin-bottom: 1.5rem;">
            "The Martha Stewart 5.3QT 12-speed mixer is an absolute beast for high-hydration sourdough dough. No motor strain whatsoever!"
          </p>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--kmh-navy); color: var(--kmh-gold); font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading);">
              MC
            </div>
            <div>
              <div style="font-weight: 700; color: var(--kmh-navy);">Chef Marcus Vance</div>
              <div style="font-size: 0.78rem; color: #64748B;">Martha Stewart 5.3QT Owner</div>
            </div>
          </div>
        </div>

        <div class="kmh-card" style="padding: 2rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <div class="kmh-rating" style="font-size: 1.1rem;">★★★★★</div>
            <span class="kmh-badge" style="background: rgba(22, 163, 74, 0.1); color: var(--kmh-success); border: 1px solid var(--kmh-success);">✓ Verified Buyer</span>
          </div>
          <p style="font-size: 1rem; color: #334155; font-style: italic; line-height: 1.7; margin-bottom: 1.5rem;">
            "The KitchenAid Classic K45SS in Onyx Black is timeless. Delivery arrived in 2 days!"
          </p>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--kmh-gold); color: var(--kmh-navy); font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading);">
              SL
            </div>
            <div>
              <div style="font-weight: 700; color: var(--kmh-navy);">Sarah Lin</div>
              <div style="font-size: 0.78rem; color: #64748B;">KitchenAid Classic Owner</div>
            </div>
          </div>
        </div>
      {% endif %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Subtitle", "default": "Verified Home Chefs" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Loved by 100,000+ Kitchens" },
    { "type": "textarea", "id": "description", "label": "Section Description", "default": "Read genuine reviews from pastry chefs, sourdough enthusiasts, and home cooks." },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review Quote Text", "default": "The 5.3QT 12-speed mixer handles heavy sourdough dough effortlessly!" },
        { "type": "text", "id": "author_name", "label": "Author Name", "default": "Chef Marcus Vance" },
        { "type": "text", "id": "author_title", "label": "Author Title / Product Bought", "default": "Martha Stewart 5.3QT Owner" },
        { "type": "text", "id": "author_initials", "label": "Avatar Initials", "default": "MV" },
        { "type": "checkbox", "id": "is_verified", "label": "Show Verified Buyer Badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        { "type": "review", "settings": { "author_name": "Chef Marcus Vance", "author_title": "Martha Stewart 5.3QT Owner", "author_initials": "MV" } },
        { "type": "review", "settings": { "author_name": "Sarah Lin", "author_title": "KitchenAid Classic Owner", "author_initials": "SL" } }
      ]
    }
  ]
}
{% endschema %}
