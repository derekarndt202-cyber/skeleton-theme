{% if section.settings.show_announcement %}
  <div class="kmh-announcement-bar" id="KMH-AnnouncementBar">
    <div class="kmh-container" style="display: flex; align-items: center; justify-content: center; position: relative;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px; text-align: center;">
        <span style="font-weight: 500; font-size: 0.85rem;">{{ section.settings.announcement_text | default: "Free Shipping on Orders $150+" }}</span>
        {% if section.settings.announcement_link != blank %}
          <a href="{{ section.settings.announcement_link }}" style="color: var(--kmh-gold); font-weight: 700; text-decoration: underline; margin-left: 6px;">{{ section.settings.link_text | default: 'Shop Now' }} &rarr;</a>
        {% endif %}
      </div>
      <button type="button" onclick="document.getElementById('KMH-AnnouncementBar').style.display='none';" aria-label="Dismiss announcement" style="position: absolute; right: 0; background: none; border: none; color: #94A3B8; font-size: 1.1rem; line-height: 1; cursor: pointer; padding: 4px;">&times;</button>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show Announcement", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Text", "default": "Free Shipping on Orders $150+" },
    { "type": "url", "id": "announcement_link", "label": "Link" },
    { "type": "text", "id": "link_text", "label": "Link Text", "default": "Shop Best Sellers" }
  ]
}
{% endschema %}
