<div style="padding: 4rem 0 0; background: {{ section.settings.background_color | default: '#FFFFFF' }};">
  <div class="kmh-container" style="text-align: center; margin-bottom: 2.5rem;">
    {% if section.settings.eyebrow != blank %}
      <span class="kmh-subtitle">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h2 class="kmh-title">{{ section.settings.heading | default: "Shop The Look" }}</h2>
    {% if section.settings.description != blank %}
      <p class="kmh-description">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0;">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div style="position: relative; padding-top: 100%; background: linear-gradient(135deg, #1E293B, #0F172A); overflow: hidden; cursor: pointer;" onmouseover="this.querySelector('.kmh-insta-overlay').style.opacity=1;" onmouseout="this.querySelector('.kmh-insta-overlay').style.opacity=0;" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <div style="position: absolute; inset:0; display: flex; align-items: center; justify-content: center; color: var(--kmh-gold); font-size: 2.5rem;">📷</div>
          {% endif %}

          <div class="kmh-insta-overlay" style="position: absolute; inset:0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; opacity: 0; transition: var(--kmh-transition); color: #FFFFFF; padding: 1rem; text-align: center;">
            <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--kmh-gold);">{{ block.settings.title }}</span>
            <span style="font-size: 0.8rem; color: #CBD5E1;">{{ block.settings.subtitle }}</span>
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="kmh-btn kmh-btn-gold kmh-btn-sm" style="margin-top: 8px;">
              Shop Featured +
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <div style="position: relative; padding-top: 100%; background: linear-gradient(135deg, #1E293B, #0F172A); overflow: hidden; cursor: pointer;" onmouseover="this.querySelector('.kmh-insta-overlay').style.opacity=1;" onmouseout="this.querySelector('.kmh-insta-overlay').style.opacity=0;">
          <div style="position: absolute; inset:0; display: flex; align-items: center; justify-content: center; color: var(--kmh-gold); font-size: 2.5rem;">
            📷
          </div>
          <div class="kmh-insta-overlay" style="position: absolute; inset:0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; opacity: 0; transition: var(--kmh-transition); color: #FFFFFF; padding: 1rem; text-align: center;">
            <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--kmh-gold);">Modern Marble Countertop</span>
            <span style="font-size: 0.8rem; color: #CBD5E1;">Martha Stewart 5.3QT in Gunmetal</span>
            <button class="kmh-btn kmh-btn-gold kmh-btn-sm" style="margin-top: 8px;" onclick="KMH_OpenCart()">Shop Featured +</button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Instagram Gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Subtitle", "default": "#KitchenMixHaven" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Shop The Look" },
    { "type": "textarea", "id": "description", "label": "Section Description", "default": "Tag @KitchenMixHaven on Instagram to be featured on our luxury kitchen inspiration gallery." },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "instagram_item",
      "name": "Gallery Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo Image" },
        { "type": "text", "id": "title", "label": "Overlay Title", "default": "Modern Marble Countertop" },
        { "type": "text", "id": "subtitle", "label": "Overlay Product Name", "default": "Martha Stewart 5.3QT Mixer" },
        { "type": "url", "id": "link", "label": "Shop Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Gallery",
      "blocks": [
        { "type": "instagram_item", "settings": { "title": "Modern Marble Countertop", "subtitle": "Martha Stewart 5.3QT Mixer" } },
        { "type": "instagram_item", "settings": { "title": "Classic Onyx Black Setup", "subtitle": "KitchenAid Classic K45SS" } }
      ]
    }
  ]
}
{% endschema %}
