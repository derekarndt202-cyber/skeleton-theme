<header class="kmh-header">
  <div class="kmh-container">
    <div class="kmh-header__inner">
      
      <!-- Mobile Nav Hamburger -->
      <button class="kmh-icon-btn mobile-only" data-mobile-nav-toggle aria-label="Toggle menu" style="display: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

      <!-- Brand Logo -->
      <a href="/" class="kmh-logo" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="{{ 'favicon.jpg' | asset_url }}" alt="KitchenMixHaven Emblem" style="height: 38px; width: 38px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.2); border: 1px solid rgba(212,175,55,0.3); object-fit: cover;">
        <span style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; tracking: 0.05em; color: var(--kmh-navy);">
          KITCHEN<span style="color: var(--kmh-gold);">MIX</span>HAVEN
        </span>
      </a>

      <!-- Desktop Navigation & Mega Menu -->
      <nav role="navigation" class="kmh-nav-wrapper">
        <ul class="kmh-nav">
          {% assign header_menu = section.settings.menu | default: linklists.main-menu %}
          {% if header_menu.links.size > 0 %}
            {% for link in header_menu.links %}
              <li style="position: relative;" class="{% if link.links.size > 0 %}kmh-has-dropdown{% endif %}">
                <a href="{{ link.url }}" class="kmh-nav__link {% if link.active %}active{% endif %}">
                  {{ link.title }}
                  {% if link.links.size > 0 %}<span style="font-size: 0.7rem; margin-left: 3px;">▾</span>{% endif %}
                </a>
                {% if link.links.size > 0 %}
                  <ul class="kmh-dropdown" style="display: none; position: absolute; top: 100%; left: 0; min-width: 220px; background: #FFFFFF; border: 1px solid var(--kmh-border); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); padding: 0.75rem 0; z-index: 100; list-style: none;">
                    {% for child in link.links %}
                      <li>
                        <a href="{{ child.url }}" style="display: block; padding: 0.5rem 1.2rem; color: var(--kmh-navy); text-decoration: none; font-size: 0.88rem; font-weight: 500;" onmouseover="this.style.background='var(--kmh-bg-light)'; this.style.color='var(--kmh-gold)';" onmouseout="this.style.background='none'; this.style.color='var(--kmh-navy)';">
                          {{ child.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            <li><a href="/collections/all" class="kmh-nav__link">Appliances</a></li>
            <li><a href="/collections/stand-mixers" class="kmh-nav__link">Stand Mixers</a></li>
            <li><a href="/pages/configurator" class="kmh-nav__link" style="color: var(--kmh-gold); font-weight: 700;">★ Build Your Mixer</a></li>
            <li><a href="/collections/coffee-espresso" class="kmh-nav__link">Coffee & Espresso</a></li>
            <li><a href="/pages/recipes" class="kmh-nav__link">Recipes</a></li>
            <li><a href="/pages/compare" class="kmh-nav__link">Compare Matrix</a></li>
          {% endif %}
        </ul>
      </nav>

      <!-- Action Icons -->
      <div class="kmh-header__icons">
        <!-- Dark Mode Switcher -->
        <button class="kmh-icon-btn" data-dark-toggle aria-label="Toggle Dark Mode" title="Toggle Light/Dark Theme">
          🌙
        </button>

        <!-- Live Search Trigger -->
        <button class="kmh-icon-btn" data-search-trigger aria-label="Search store">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>

        <!-- Wishlist -->
        <a href="/pages/wishlist" class="kmh-icon-btn" aria-label="View Wishlist" style="position: relative;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          <span class="kmh-badge-count" data-wishlist-count>0</span>
        </a>

        <!-- Account -->
        <a href="/account" class="kmh-icon-btn" aria-label="Customer Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>

        <!-- AJAX Cart Drawer Trigger -->
        <button class="kmh-icon-btn" data-cart-trigger aria-label="Open cart" style="position: relative; background: var(--kmh-navy); color: var(--kmh-gold); border-color: var(--kmh-navy);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
          <span class="kmh-badge-count" style="background: var(--kmh-gold); color: var(--kmh-navy);">{{ cart.item_count }}</span>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
