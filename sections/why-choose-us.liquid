<div style="background-color: {{ section.settings.background_color | default: 'var(--kmh-navy)' }}; color: #FFFFFF; padding: 4rem 0; border-top: 1px solid rgba(212,175,55,0.2); border-bottom: 1px solid rgba(212,175,55,0.2);">
  <div class="kmh-container">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      {% if section.settings.eyebrow != blank %}
        <span style="color: var(--kmh-gold); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 style="font-family: var(--font-heading); color: #FFFFFF; font-size: 2.2rem; margin-top: 0.5rem;">{{ section.settings.heading | default: "Why Home Chefs Trust Us" }}</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
      
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}>
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212,175,55,0.15); border: 1px solid var(--kmh-gold); color: var(--kmh-gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem;">
              {{ block.settings.icon | default: "★" }}
            </div>
            <h4 style="color: #FFFFFF; font-size: 1.1rem; margin-bottom: 0.4rem;">{{ block.settings.title }}</h4>
            <p style="font-size: 0.85rem; color: #94A3B8;">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Presets -->
        <div>
          <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212,175,55,0.15); border: 1px solid var(--kmh-gold); color: var(--kmh-gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <h4 style="color: #FFFFFF; font-size: 1.1rem; margin-bottom: 0.4rem;">Premium Build</h4>
          <p style="font-size: 0.85rem; color: #94A3B8;">Commercial grade die-cast metal housing & all-metal gears.</p>
        </div>

        <div>
          <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212,175,55,0.15); border: 1px solid var(--kmh-gold); color: var(--kmh-gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h4 style="color: #FFFFFF; font-size: 1.1rem; margin-bottom: 0.4rem;">Fast Shipping</h4>
          <p style="font-size: 0.85rem; color: #94A3B8;">Free expedited courier delivery on all orders over $150.</p>
        </div>

        <div>
          <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212,175,55,0.15); border: 1px solid var(--kmh-gold); color: var(--kmh-gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h4 style="color: #FFFFFF; font-size: 1.1rem; margin-bottom: 0.4rem;">Secure Checkout</h4>
          <p style="font-size: 0.85rem; color: #94A3B8;">256-bit encrypted checkout & fraud protection system.</p>
        </div>

        <div>
          <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212,175,55,0.15); border: 1px solid var(--kmh-gold); color: var(--kmh-gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 style="color: #FFFFFF; font-size: 1.1rem; margin-bottom: 0.4rem;">5-Year Warranty</h4>
          <p style="font-size: 0.85rem; color: #94A3B8;">Comprehensive motor and housing coverage guarantee.</p>
        </div>
      {% endif %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section Eyebrow", "default": "The KitchenMixHaven Standard" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Why Home Chefs Trust Us" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#0F172A" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon Symbol or Emoji", "default": "★" },
        { "type": "text", "id": "title", "label": "Feature Title", "default": "Premium Build" },
        { "type": "textarea", "id": "text", "label": "Feature Description", "default": "Commercial grade die-cast metal housing & all-metal gears." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        { "type": "feature", "settings": { "icon": "⭐", "title": "Premium Build", "text": "Commercial grade die-cast metal housing & all-metal gears." } },
        { "type": "feature", "settings": { "icon": "🚚", "title": "Fast Shipping", "text": "Free expedited courier delivery on all orders over $150." } },
        { "type": "feature", "settings": { "icon": "🔒", "title": "Secure Checkout", "text": "256-bit encrypted checkout & fraud protection system." } },
        { "type": "feature", "settings": { "icon": "🛡️", "title": "5-Year Warranty", "text": "Comprehensive motor and housing coverage guarantee." } }
      ]
    }
  ]
}
{% endschema %}
