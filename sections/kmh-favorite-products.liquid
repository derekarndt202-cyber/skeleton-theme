<section class="kmh-favorite-products" style="--kmh-accent: {{ section.settings.accent_color }};">
  <div class="kmh-favorite-products__heading">
    <p>{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.text }}</div>
  </div>
  <div class="kmh-product-grid">
    {% if section.settings.products != blank %}
      {% for product in section.settings.products limit: section.settings.products_to_show %}
        <a class="kmh-favorite-product" href="{{ product.url }}">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}
          <span>{{ product.title }}</span>
          <strong>{{ product.price | money }}</strong>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="kmh-favorite-product"><div class="kmh-favorite-product__placeholder"></div><span>Favorite mixer pick {{ i }}</span><strong>{{ 14999 | money }}</strong></div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .kmh-favorite-products { padding: 4rem 0; }
  .kmh-favorite-products__heading { display: grid; gap: .8rem; max-width: 760px; margin-bottom: 1.5rem; }
  .kmh-favorite-products__heading p { color: var(--kmh-accent); font-size: .78rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .kmh-favorite-products__heading h2 { font-size: clamp(2rem, 5vw, 4.25rem); line-height: .95; }
  .kmh-favorite-products__heading div { line-height: 1.7; color: rgba(32,25,21,.72); }
  .kmh-product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .kmh-favorite-product { display: grid; gap: .65rem; padding: 1rem; color: #201915; text-decoration: none; border: 1px solid rgba(32,25,21,.1); border-radius: 1.35rem; background: #fff; box-shadow: 0 18px 50px rgba(32,25,21,.08); }
  .kmh-favorite-product img, .kmh-favorite-product__placeholder { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 1rem; background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--kmh-accent), white 70%), #fff7ef); }
  .kmh-favorite-product span, .kmh-favorite-product strong { display: block; }
  .kmh-favorite-product span { font-weight: 850; }
  .kmh-favorite-product strong { color: var(--kmh-accent); }
  @media (max-width: 980px) { .kmh-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .kmh-product-grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "KMH favorite products",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#6c5cff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Favorite products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best picks for modern kitchens." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pin your highest-converting mixers and accessories so shoppers do not land on an empty storefront.</p>" },
    { "type": "product_list", "id": "products", "label": "Products" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "KMH favorite products" }]
}
{% endschema %}
