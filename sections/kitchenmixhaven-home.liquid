{% liquid
  assign featured_collection = section.settings.featured_collection
  assign hub_collection = section.settings.hub_collection
%}

<section class="kmh-home kmh-home--future full-width" style="--kmh-accent: {{ section.settings.accent_color }}; --kmh-accent-2: {{ section.settings.secondary_color }}; --kmh-neon: {{ section.settings.neon_color }}; --kmh-space: {{ section.settings.space_color }}; --kmh-surface: {{ section.settings.surface_color }};">
  <div class="kmh-orb kmh-orb--one"></div>
  <div class="kmh-orb kmh-orb--two"></div>

  <div class="kmh-hero">
    <div class="kmh-hero__content">
      {% if section.settings.eyebrow != blank %}<p class="kmh-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <div class="kmh-hero__text">{{ section.settings.text }}</div>
      <div class="kmh-actions">
        {% if section.settings.primary_label != blank %}<a class="kmh-button kmh-button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="kmh-button kmh-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </div>

    <div class="kmh-command-center">
      <div class="kmh-command-center__screen">
        {% if section.settings.hero_image %}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.heading }}
        {% else %}
          <div class="kmh-mixer-holo" aria-hidden="true">
            <span class="kmh-mixer-holo__ring"></span>
            <span class="kmh-mixer-holo__head"></span>
            <span class="kmh-mixer-holo__stand"></span>
            <span class="kmh-mixer-holo__bowl"></span>
          </div>
        {% endif %}
      </div>
      <div class="kmh-command-center__panel">
        <span>{{ section.settings.panel_stat_1 }}</span>
        <span>{{ section.settings.panel_stat_2 }}</span>
        <span>{{ section.settings.panel_stat_3 }}</span>
      </div>
    </div>
  </div>

  <div class="kmh-hub" id="mixer-hub">
    <div class="kmh-section-heading">
      <div>
        <p class="kmh-eyebrow">{{ section.settings.hub_eyebrow }}</p>
        <h2>{{ section.settings.hub_heading }}</h2>
      </div>
      {% if hub_collection %}<a href="{{ hub_collection.url }}">Explore hub</a>{% endif %}
    </div>

    <div class="kmh-hub__grid">
      <div class="kmh-hub__primary">
        <h3>{{ section.settings.hub_feature_heading }}</h3>
        <p>{{ section.settings.hub_feature_text }}</p>
        <a class="kmh-link-pill" href="{{ section.settings.hub_feature_link }}">{{ section.settings.hub_feature_label }}</a>
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'hub_tile' %}
          <a class="kmh-hub-tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.icon }}</span>
            <strong>{{ block.settings.title }}</strong>
            <small>{{ block.settings.description }}</small>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="kmh-guide" id="buying-guide">
    <div class="kmh-section-heading">
      <div>
        <p class="kmh-eyebrow">{{ section.settings.guide_eyebrow }}</p>
        <h2>{{ section.settings.guide_heading }}</h2>
      </div>
    </div>
    <div class="kmh-guide__steps">
      {% for block in section.blocks %}
        {% if block.type == 'guide_step' %}
          <article class="kmh-guide-step" {{ block.shopify_attributes }}>
            <span>{{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="kmh-featured">
    <div class="kmh-section-heading">
      <div>
        <p class="kmh-eyebrow">{{ section.settings.featured_eyebrow }}</p>
        <h2>{{ section.settings.featured_heading }}</h2>
      </div>
      {% if featured_collection %}<a href="{{ featured_collection.url }}">Shop all</a>{% endif %}
    </div>
    <div class="kmh-products">
      {% if featured_collection and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <a class="kmh-product-card" href="{{ product.url }}">
            {% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}
            <span>{{ product.title }}</span>
            <strong>{{ product.price | money }}</strong>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="kmh-product-card kmh-product-card--placeholder"><div></div><span>Future-ready mixer {{ i }}</span><strong>{{ 14999 | money }}</strong></div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .kmh-home--future { position: relative; isolation: isolate; overflow: hidden; background: radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--kmh-neon), transparent 72%), transparent 30rem), linear-gradient(135deg, var(--kmh-space), #17111f 48%, #fff8ee 48.2%); color: #fff; }
  .kmh-orb { position: absolute; z-index: -1; width: 22rem; height: 22rem; border-radius: 50%; filter: blur(22px); opacity: .36; }
  .kmh-orb--one { top: 6rem; right: 8%; background: var(--kmh-neon); }
  .kmh-orb--two { top: 42rem; left: -8rem; background: var(--kmh-accent); }
  .kmh-hero, .kmh-hub, .kmh-guide, .kmh-featured { width: min(var(--page-width), calc(100% - var(--page-margin) * 2)); margin-inline: auto; }
  .kmh-hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(320px, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; padding: 5rem 0 3rem; }
  .kmh-eyebrow { color: var(--kmh-neon); font-weight: 900; letter-spacing: .16em; text-transform: uppercase; font-size: .78rem; margin-bottom: .8rem; }
  .kmh-hero h1 { font-size: clamp(3rem, 8vw, 6.8rem); line-height: .86; max-width: 10ch; text-wrap: balance; }
  .kmh-hero__text { color: rgba(255, 255, 255, .82); font-size: 1.15rem; line-height: 1.75; max-width: 60ch; margin-top: 1.35rem; }
  .kmh-actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; }
  .kmh-button, .kmh-link-pill { border-radius: 999px; padding: .95rem 1.35rem; font-weight: 900; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .kmh-button--primary, .kmh-link-pill { background: linear-gradient(135deg, var(--kmh-accent), var(--kmh-neon)); color: #fff; box-shadow: 0 0 30px color-mix(in srgb, var(--kmh-neon), transparent 55%); }
  .kmh-button--secondary { color: #fff; border: 1px solid rgba(255, 255, 255, .32); background: rgba(255, 255, 255, .08); }
  .kmh-command-center { display: grid; gap: 1rem; }
  .kmh-command-center__screen { min-height: 430px; border: 1px solid rgba(255, 255, 255, .24); border-radius: 2rem; background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.04)); box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), 0 30px 100px rgba(0,0,0,.35); display: grid; place-items: center; overflow: hidden; backdrop-filter: blur(18px); }
  .kmh-command-center__screen img { width: 100%; height: 100%; object-fit: cover; }
  .kmh-command-center__panel { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .kmh-command-center__panel span { border: 1px solid rgba(255,255,255,.18); border-radius: 1rem; padding: .85rem; background: rgba(255,255,255,.1); font-size: .86rem; font-weight: 800; text-align: center; }
  .kmh-mixer-holo { position: relative; width: 290px; height: 290px; }
  .kmh-mixer-holo__ring { position: absolute; inset: 12px; border: 2px solid var(--kmh-neon); border-radius: 50%; box-shadow: 0 0 35px var(--kmh-neon); }
  .kmh-mixer-holo__head { position: absolute; width: 220px; height: 92px; background: linear-gradient(135deg, var(--kmh-accent), var(--kmh-neon)); border-radius: 58% 42% 45% 55%; top: 48px; left: 35px; }
  .kmh-mixer-holo__stand { position: absolute; width: 56px; height: 145px; background: #fff; border-radius: 28px; left: 117px; top: 104px; opacity: .9; }
  .kmh-mixer-holo__bowl { position: absolute; width: 220px; height: 105px; background: rgba(255,255,255,.72); border: 7px solid rgba(255,255,255,.9); border-radius: 0 0 110px 110px; bottom: 18px; left: 35px; }
  .kmh-hub, .kmh-guide, .kmh-featured { padding: 3rem 0; color: #201915; }
  .kmh-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .kmh-section-heading h2 { font-size: clamp(2rem, 5vw, 4rem); line-height: 1; text-wrap: balance; }
  .kmh-section-heading a { color: inherit; font-weight: 900; }
  .kmh-hub__grid { display: grid; grid-template-columns: 1.3fr repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .kmh-hub__primary, .kmh-hub-tile, .kmh-guide-step, .kmh-product-card { border: 1px solid rgba(32, 25, 21, .1); border-radius: 1.35rem; background: rgba(255,255,255,.82); box-shadow: 0 18px 50px rgba(32, 25, 21, .08); color: #201915; }
  .kmh-hub__primary { grid-row: span 2; min-height: 300px; display: flex; flex-direction: column; justify-content: end; padding: clamp(1.25rem, 4vw, 2rem); background: linear-gradient(145deg, #fff, var(--kmh-surface)); }
  .kmh-hub__primary h3 { font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: .95; margin-bottom: 1rem; }
  .kmh-hub__primary p { line-height: 1.7; margin-bottom: 1.25rem; max-width: 54ch; }
  .kmh-hub-tile { display: grid; gap: .45rem; min-height: 145px; padding: 1.2rem; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .kmh-hub-tile:hover { transform: translateY(-4px); box-shadow: 0 24px 70px rgba(32, 25, 21, .12); }
  .kmh-hub-tile span { font-size: 2rem; }
  .kmh-hub-tile strong { font-size: 1.1rem; }
  .kmh-hub-tile small { font-size: .95rem; line-height: 1.5; color: rgba(32, 25, 21, .68); }
  .kmh-guide__steps, .kmh-products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .kmh-guide-step { padding: 1.25rem; }
  .kmh-guide-step span { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #201915; color: #fff; font-weight: 900; margin-bottom: 1rem; }
  .kmh-guide-step h3 { margin-bottom: .5rem; }
  .kmh-guide-step p { line-height: 1.6; color: rgba(32, 25, 21, .72); }
  .kmh-product-card { padding: 1rem; text-decoration: none; }
  .kmh-product-card img, .kmh-product-card--placeholder div { aspect-ratio: 1; object-fit: cover; width: 100%; border-radius: 1rem; background: linear-gradient(135deg, var(--kmh-surface), #fff); margin-bottom: .9rem; }
  .kmh-product-card span, .kmh-product-card strong { display: block; }
  @media (max-width: 980px) { .kmh-hero, .kmh-hub__grid, .kmh-guide__steps, .kmh-products { grid-template-columns: 1fr 1fr; } .kmh-hero__content { grid-column: 1 / -1; } }
  @media (max-width: 680px) { .kmh-hero, .kmh-hub__grid, .kmh-guide__steps, .kmh-products, .kmh-command-center__panel { grid-template-columns: 1fr; } .kmh-command-center__screen { min-height: 320px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "KitchenMixHaven future home",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ff6a3d" },
    { "type": "color", "id": "secondary_color", "label": "Secondary color", "default": "#ffd8a8" },
    { "type": "color", "id": "neon_color", "label": "Neon color", "default": "#6c5cff" },
    { "type": "color", "id": "space_color", "label": "Hero space color", "default": "#100d1f" },
    { "type": "color", "id": "surface_color", "label": "Soft card background", "default": "#fff4e7" },
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "KitchenMixHaven mixer intelligence" },
    { "type": "text", "id": "heading", "label": "Hero heading", "default": "The future hub for smarter mixing." },
    { "type": "richtext", "id": "text", "label": "Hero text", "default": "<p>Navigate stand mixers, hand mixers, attachments, and kitchen workflows with a guided hub built for bakers, meal preppers, and curious home cooks.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Enter mixer hub" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "default": "#mixer-hub" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Read buying guide" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "default": "#buying-guide" },
    { "type": "text", "id": "panel_stat_1", "label": "Panel stat 1", "default": "Bowl size matrix" },
    { "type": "text", "id": "panel_stat_2", "label": "Panel stat 2", "default": "Power match guide" },
    { "type": "text", "id": "panel_stat_3", "label": "Panel stat 3", "default": "Attachment paths" },
    { "type": "text", "id": "hub_eyebrow", "label": "Hub eyebrow", "default": "Multi-level mixer hub" },
    { "type": "text", "id": "hub_heading", "label": "Hub heading", "default": "Start with how you cook, then level up." },
    { "type": "collection", "id": "hub_collection", "label": "Hub collection link" },
    { "type": "text", "id": "hub_feature_heading", "label": "Hub feature heading", "default": "Build your ideal mixing system" },
    { "type": "textarea", "id": "hub_feature_text", "label": "Hub feature text", "default": "Use the hub to compare mixer formats, understand capacity, plan attachments, and move from first purchase to advanced kitchen workflows." },
    { "type": "text", "id": "hub_feature_label", "label": "Hub feature button", "default": "Shop all mixers" },
    { "type": "url", "id": "hub_feature_link", "label": "Hub feature link", "default": "/collections/all" },
    { "type": "text", "id": "guide_eyebrow", "label": "Guide eyebrow", "default": "Buying guide" },
    { "type": "text", "id": "guide_heading", "label": "Guide heading", "default": "Four decisions before you buy." },
    { "type": "text", "id": "featured_eyebrow", "label": "Featured eyebrow", "default": "Featured systems" },
    { "type": "text", "id": "featured_heading", "label": "Featured heading", "default": "Mixer essentials for every level" },
    { "type": "collection", "id": "featured_collection", "label": "Featured collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    { "type": "hub_tile", "name": "Hub tile", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🍞" },
      { "type": "text", "id": "title", "label": "Title", "default": "Dough lab" },
      { "type": "text", "id": "description", "label": "Description", "default": "High-torque systems for breads, pizza, and enriched dough." },
      { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
    ] },
    { "type": "guide_step", "name": "Buying guide step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Choose capacity" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Pick compact bowls for small kitchens, or larger bowls if you batch bake or prep weekly." }
    ] }
  ],
  "presets": [
    { "name": "KitchenMixHaven future home", "blocks": [
      { "type": "hub_tile", "settings": { "icon": "🍞", "title": "Dough lab", "description": "High-torque systems for breads, pizza, and enriched dough." } },
      { "type": "hub_tile", "settings": { "icon": "🧁", "title": "Bake station", "description": "Creaming, whipping, and mixing paths for cakes and cookies." } },
      { "type": "hub_tile", "settings": { "icon": "🥗", "title": "Prep cockpit", "description": "Compact helpers for sauces, salads, and fast weeknight prep." } },
      { "type": "hub_tile", "settings": { "icon": "⚙️", "title": "Attachment deck", "description": "Pasta, grinder, slicer, and specialty add-ons explained." } },
      { "type": "guide_step", "settings": { "title": "Choose capacity", "text": "Pick compact bowls for small kitchens, or larger bowls if you batch bake or prep weekly." } },
      { "type": "guide_step", "settings": { "title": "Match the motor", "text": "Prioritize torque and stability for dense dough, and speed range for meringues or creams." } },
      { "type": "guide_step", "settings": { "title": "Plan attachments", "text": "Think beyond today: pasta, slicers, grinders, and extra bowls can expand one mixer." } },
      { "type": "guide_step", "settings": { "title": "Check footprint", "text": "Measure counter clearance, storage height, bowl access, and outlet placement before checkout." } }
    ] }
  ]
}
{% endschema %}
