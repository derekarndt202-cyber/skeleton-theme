{% style %}
  :root {
    --kmh-navy: {{ settings.color_primary | default: '#0F172A' }};
    --kmh-charcoal: {{ settings.color_secondary | default: '#111827' }};
    --kmh-gold: {{ settings.color_accent | default: '#D4AF37' }};
    --kmh-bg: {{ settings.color_background | default: '#FFFFFF' }};
    --kmh-bg-light: {{ settings.color_bg_light | default: '#F8FAFC' }};
    --kmh-border: {{ settings.color_border | default: '#E5E7EB' }};
    --kmh-success: {{ settings.color_success | default: '#16A34A' }};
    
    --font-heading: {{ settings.heading_font | default: "'Playfair Display', serif" }};
    --font-body: {{ settings.body_font | default: "'Inter', sans-serif" }};
    
    --radius-card: {{ settings.card_corner_radius | default: 14 }}px;
    --radius-button: {{ settings.button_corner_radius | default: 10 }}px;
    
    --page-width: {{ settings.page_max_width | default: '1440px' }};
    --page-margin: 24px;
    
    --kmh-shadow-subtle: 0 4px 20px rgba(15, 23, 42, 0.05);
    --kmh-shadow-hover: 0 20px 40px rgba(15, 23, 42, 0.12);
    --kmh-shadow-drawer: -10px 0 30px rgba(15, 23, 42, 0.15);
    
    --kmh-transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
{% endstyle %}
